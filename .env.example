# ── PostgreSQL ────────────────────────────────────────────────────────────────
# REQUIRED — change before deploying to any shared or production environment
POSTGRES_PASSWORD=AVNS_change

API_DATABASE_URL=postgresql+asyncpg://avnadmin:AVNS_change@fbref-baudo-spoon.k.aivencloud.com:17628/defaultdb?ssl=require
ML_DATABASE_URL=postgresql+psycopg2://avnadmin:AVNS_change@fbref-baudo-spoon.k.aivencloud.com:17628/defaultdb?sslmode=require
SCRAPER_DATABASE_URL=postgresql+psycopg2://avnadmin:AVNS_change@fbref-baudo-spoon.k.aivencloud.com:17628/defaultdb?sslmode=require

ML_R2_ENDPOINT_URL=https://<your-account-id>.r2.cloudflarestorage.com
ML_R2_ACCESS_KEY_ID=
ML_R2_SECRET_ACCESS_KEY=
ML_R2_BUCKET_NAME=baudo-spoon-ml-artifacts

API_R2_ENDPOINT_URL=https://<your-account-id>.r2.cloudflarestorage.com
API_R2_ACCESS_KEY_ID=
API_R2_SECRET_ACCESS_KEY=
API_R2_BUCKET_NAME=baudo-spoon-ml-artifacts

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=8000
LOG_LEVEL=INFO
DEBUG=true

# Secret token required in X-API-Key header for /intelligence endpoints.
# Leave empty to disable authentication (dev/local only).
API_KEY_SECRET=

# Redis cache TTL for ML artifact responses (seconds).
API_CACHE_TTL_SECONDS=3600

# Sliding-window rate limit applied per client IP on /intelligence endpoints.
API_RATE_LIMIT_REQUESTS=60
API_RATE_LIMIT_WINDOW_SECONDS=60

# ── Scraper (override defaults inside the container) ─────────────────────────
# SCRAPER_RETRIES=3
# SCRAPER_CACHE_DIR=/app/downloaded_files/cache
# SCRAPER_OUTPUT_DIR=/app/downloaded_files/output

# ── ML pipeline ───────────────────────────────────────────────────────────────
# ML_RANDOM_SEED=42
